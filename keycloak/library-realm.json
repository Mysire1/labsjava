{
  "realm": "library",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "USER" },
      { "name": "ADMIN" }
    ]
  },
  "clients": [
    {
      "clientId": "library-app",
      "enabled": true,
      "publicClient": false,
      "secret": "library-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8080/*", "http://library.local/*"],
      "webOrigins": ["http://localhost:8080", "http://library.local"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8080/*##http://library.local/*"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "user",
      "enabled": true,
      "email": "user@library.local",
      "emailVerified": true,
      "firstName": "Regular",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "user", "temporary": false }],
      "realmRoles": ["USER"]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@library.local",
      "emailVerified": true,
      "firstName": "Library",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["USER", "ADMIN"]
    }
  ]
}
